# ===== Server =====
PORT=8000
APP_NAME=hdmeal-backend
DEBUG=false

# ===== MongoDB =====
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=hdmeal

# ===== NEIS OpenAPI (https://open.neis.go.kr) =====
NEIS_OPENAPI_TOKEN=your-neis-openapi-token
ATPT_OFCDC_SC_CODE=
SD_SCHUL_CODE=
NUM_OF_GRADES=3
NUM_OF_CLASSES=10

# ===== KMA Weather (https://apis.data.go.kr/1360000) =====
HDMeal_KMA_ApiKey=your-kma-service-key
HDMeal_KMA_NX=60
HDMeal_KMA_NY=127

# ===== Seoul Open Data (한강 수온) =====
HDMeal_SeoulData_Token=your-seoul-openapi-token

# ===== Auth (skill + user settings) =====
# JSON 배열 또는 콤마 구분 문자열 둘 다 허용
HDMeal_AuthTokens='["your-auth-token-1","your-auth-token-2"]'
HDMeal_JWTSecret=your-jwt-hs256-secret
HDMeal_BaseURL=https://example.com

# ===== CORS =====
# JSON 배열 또는 콤마 구분 문자열. "*" 단독은 와일드카드.
HDMeal_AllowedOrigins='["https://example.com"]'

# ===== Limits / app meta =====
HDMeal_MaxDaysRange=31
HDMeal_AppVersion=2.2.0
HDMeal_AppBuild=120

# ===== Cache health TTLs =====
CACHE_HEALTH_TIMETABLE_TTL_HOURS=3
CACHE_HEALTH_WEATHER_TTL_HOURS=1
CACHE_HEALTH_WATER_TEMP_TTL_MINUTES=76

# ===== Observability (OTel) =====
# OTLP endpoint for traces (gRPC). 비워두면 비활성화.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=hdmeal-backend
# 로그 레벨: trace|debug|info|warn|error
RUST_LOG=info
